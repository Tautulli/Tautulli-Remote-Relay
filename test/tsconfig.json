{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // `types` replaces rather than extends, so the runtime types the root config
    // pulls in have to be repeated alongside the 'cloudflare:test' module types.
    "types": ["@cloudflare/workers-types/experimental", "@cloudflare/vitest-pool-workers"]
  },
  "include": ["./**/*.ts", "../vitest.config.ts", "../vitest.*.config.ts"]
}
