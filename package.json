{
  "name": "tautulli-remote-relay",
  "version": "1.0.0",
  "description": "Stateless push notification relay for Tautulli Remote: forwards encrypted notification payloads from Tautulli servers to devices via Firebase Cloud Messaging.",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.14",
    "@cloudflare/workers-types": "^4.20250906.0",
    "typescript": "^7.0.2",
    "vitest": "~3.2.0",
    "wrangler": "~4.36.0"
  }
}
